# INTENTIONALLY BROKEN: ready has no dependency and can run before tests pass.
# This file is inert. Follow Lab 2 rather than activating this whole fixture.
name: BROKEN - Missing job dependency

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix:
        node: ['22', '24']
        suite: [unit, integration]
    steps:
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-node@v7
        with:
          node-version: ${{ matrix.node }}
          package-manager-cache: false
      - run: npm ci
      - env:
          TEST_SUITE: ${{ matrix.suite }}
        run: npm run "test:$TEST_SUITE"

  ready:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - run: printf 'BUG - This can announce readiness before testing finishes.\n'
